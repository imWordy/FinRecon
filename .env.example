# FinRecon Environment Configuration Template
# Duplicate this file to .env and configure your local settings.

# LLM Provider Configuration ("ollama" or "openai" or "mock")
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional: Cloud LLM API Keys (Only if not using local Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector Store / RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=./rag/faiss_index

# Synthetic Data Configuration
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
RANDOM_SEED=42
